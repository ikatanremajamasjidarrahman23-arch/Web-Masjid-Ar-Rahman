generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id                 String   @id @default(cuid())
  visi               String?
  misi               String?
  sejarah            String?
  logoUrl            String? // URL logo masjid
  strukturOrganisasi String? // URL gambar struktur organisasi
  qrisImage          String? // URL gambar QRIS donasi
  runningText        String? // Teks berjalan di header website
  deskripsiSingkat   String? // Deskripsi singkat untuk footer
  alamat             String?
  telepon            String?
  email              String?
  popupImage         String? // URL gambar popup pengumuman
  popupIsActive      Boolean  @default(false) // Status popup nyala/mati
  popupDuration      Int      @default(10) // Durasi tayang popup dalam detik
  fontFamily         String?  @default("inter") // Pilihan font utama website
  themeColor         String   @default("emerald") // Tema warna utama website
  runningTextSpeed   Int      @default(25) // Kecepatan teks berjalan dalam detik
  irmasLogoUrl       String?  // URL logo khusus IRMAS
  logoSizeNavbar     Int      @default(48) // Tinggi logo Navbar dalam px
  logoSizeProfil     Int      @default(80) // Tinggi logo Profil dalam px
  logoSizeIrmas      Int      @default(80) // Tinggi logo IRMAS dalam px
  
  // Teks Dinamis Beranda
  selayangPandangTitle       String?  @default("Selayang Pandang")
  selayangPandangDescription String?  @db.Text
  ukmTitle                   String?  @default("Unit Kegiatan Masjid")
  ukmDescription             String?  @db.Text
  
  // Konfigurasi API Tambahan
  cloudinaryCloudName String?
  cloudinaryApiKey    String?
  cloudinaryApiSecret String?

  // AD/ART Kepengurusan
  adArtContent       String? @db.Text // Teks manual
  adArtFileUrl       String? // URL file PDF atau Gambar

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PhbiEvent {
  id          String      @id @default(cuid())
  title       String      // cth: Isra Mi'raj 1445 H
  description String?
  date        DateTime
  linkMore    String?     // Link eksternal untuk galeri tambahan
  media       PhbiMedia[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model PhbiMedia {
  id        String    @id @default(cuid())
  type      String    // "IMAGE" atau "VIDEO"
  url       String    // URL dari Cloudinary atau ID YouTube
  eventId   String
  event     PhbiEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
}

model IrmasActivity {
  id        String   @id @default(cuid())
  title     String
  content   String
  imageUrl  String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IrmasMemberRegistration {
  id        String   @id @default(cuid())
  name      String
  phone     String
  address   String
  reason    String?
  createdAt DateTime @default(now())
}

model Finance {
  id          String        @id @default(cuid())
  type        String        // "IN" atau "OUT"
  amount      Float
  description String
  date        DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model StudySchedule {
  id          String   @id @default(cuid())
  title       String
  speaker     String
  schedule    String
  location    String   @default("Ruang Utama Masjid")
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Gallery {
  id            String   @id @default(cuid())
  title         String
  category      String
  imageUrl      String
  imagePosition String   @default("center")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Bulletin {
  id            String   @id @default(cuid())
  title         String
  description   String
  imageUrl      String?
  imagePosition String   @default("center")
  expiryDate    DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OrganizationMember {
  id        String   @id @default(cuid())
  name      String
  position  String
  parentId  String?
  parent    OrganizationMember?  @relation("MemberToMember", fields: [parentId], references: [id], onDelete: SetNull)
  children  OrganizationMember[] @relation("MemberToMember")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminNote {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ukm {
  id              String   @id @default(cuid())
  namaUkm         String
  kategori        String
  deskripsi       String   @db.Text
  jadwalKegiatan  String?
  pembina         String?
  linkSelengkapnya String?
  imageUrl        String?
  galleryImages   String[] @default([])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
